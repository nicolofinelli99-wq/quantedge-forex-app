# --- Database (already set in Vercel) ---
DATABASE_URL="postgresql://user:pass@host:5432/db"

# --- Session security (already set in Vercel) ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Demo mode ---
# When "true", enables the one-click "Continue as Desk Admin" demo login and the
# client dashboard's "simulate payment failed" toggle. Set to "false" (or delete
# the var) before real customers start signing up.
DEMO_MODE="true"

# --- Seed endpoint (already set in Vercel) ---
SEED_SECRET=""

# --- Stripe (fill in once the client shares their Stripe account) ---
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=""
# Dashboard > Developers > Webhooks > (endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=""
# Dashboard > Product catalog > each plan's Price ID (one per plan x billing cycle)
STRIPE_PRICE_RESEARCH_MONTHLY=""
STRIPE_PRICE_RESEARCH_YEARLY=""
STRIPE_PRICE_STRATEGY_MONTHLY=""
STRIPE_PRICE_STRATEGY_YEARLY=""
STRIPE_PRICE_COMPLETE_MONTHLY=""
STRIPE_PRICE_COMPLETE_YEARLY=""

# --- Resend (transactional email) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
# Must be on a domain verified in Resend. Until then, leave unset and emails
# fall back to Resend's shared test sender (onboarding@resend.dev).
EMAIL_FROM="BE4 Trading <no-reply@yourdomain.com>"
